# Kopiere diese Datei zu ".env" und trage dort deine echten Zugangsdaten ein.
# .env wird nie ins Git-Repo aufgenommen (siehe .gitignore).

DFBNET_USERNAME=
DFBNET_PASSWORD=

# Sportstätten-Nummer fuer die Platzbelegungs-Abfrage (Karl-Kleine-Stadion Hoeingen)
DFBNET_SPORTSTAETTE_NR=2100290091

# E-Mail-Benachrichtigung bei Anomalien (Google Workspace, app@hoeinger-sv.de)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=app@hoeinger-sv.de
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=uli.knieper@hoeinger-sv.de
